# Copia a .env y cambia los valores. .env NUNCA va al repo (está en .gitignore).
# Genera secretos con:  python -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Django ---
DJANGO_SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,tu-dominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,https://tu-dominio.com
# Pon 1 cuando tengas HTTPS
DJANGO_SECURE_COOKIES=0
# Carga el historial del Excel al arrancar (idempotente)
SEED_ON_START=1

# --- Postgres ---
POSTGRES_DB=jobmachine
POSTGRES_USER=jobmachine
POSTGRES_PASSWORD=cambia-esta-contrasena

# --- Tu usuario del panel (se crea al primer arranque) ---
ADMIN_USERNAME=darkn
ADMIN_PASSWORD=cambia-esta-contrasena


# --- CI/CD: imágenes que publica GitHub Actions en GHCR ---
# ghcr.io/<tu-usuario-github-en-minúsculas>. IMAGE_TAG lo fija scripts/deploy.sh en cada deploy.
IMAGE_REGISTRY=ghcr.io/tu-usuario
IMAGE_TAG=latest
